# --- Source: Ville d'Albi CKAN open-data portal (read access, JWT bearer) ---
export ALBI_KEY="<ckan-api-token>"
export ALBI_API_BASE="https://opendata.mairie-albi.fr/api/3/action"

# --- OpenAgenda target ---
# Production agenda (default target of `node scripts/sync.js`)
export AGENDA_UID="93399464"
export API_SECRET="<oa_sk_... production secret>"
# Test agenda (used when the sync is run with the --test flag)
export TEST_AGENDA_UID="37607380"
export TEST_API_SECRET="<oa_sk_... test secret>"

# --- State ---
# Where the incremental sync registry (.sync-state.json) is read/written.
# Set this to a persistent path on the deployment server (e.g. a mounted volume).
# Defaults to <project>/.sync-state.json when unset.
export STATE_FILE_PATH="/var/lib/synchro-albigeois/sync-state.json"
